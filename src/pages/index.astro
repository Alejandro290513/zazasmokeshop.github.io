---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';

const categories = products.reduce((acc, product) => {
  if (!acc[product.category]) {
    acc[product.category] = { slug: product.categorySlug, products: [] };
  }
  acc[product.category].products.push(product);
  return acc;
}, {} as Record<string, { slug: string; products: typeof products }>);

const categoryIcons: Record<string, string> = {
  "Cápsulas": "fa-capsules",
  "Cápsulas Tipo Importadas": "fa-flask",
  "Cápsulas Importadas Originales": "fa-star",
  "Baterías": "fa-bolt",
  "Extracciones": "fa-fire",
  "Desechables": "fa-wind",
  "Comestibles: Gomas": "fa-candy-cane",
  "Comestibles: Otros": "fa-leaf",
};

const categoryAccentColors: Record<string, string> = {
  "Cápsulas": "cyan",
  "Cápsulas Tipo Importadas": "purple",
  "Cápsulas Importadas Originales": "amber",
  "Baterías": "yellow",
  "Extracciones": "orange",
  "Desechables": "teal",
  "Comestibles: Gomas": "pink",
  "Comestibles: Otros": "emerald",
};

const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- HEADER PRINCIPAL - Fondo integrado con el cuerpo -->
  <header class="relative overflow-hidden bg-[#0A0A0F]" id="top">
    <!-- Gradiente atmosférico que se fusiona con el fondo general -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.04),transparent_70%),radial-gradient(ellipse_at_top,rgba(6,182,212,0.03),transparent_50%)] pointer-events-none"></div>
    
    <div class="relative container mx-auto px-4 pt-5 pb-3 sm:pt-8 sm:pb-4">
      <!-- Barra superior con carrito -->
      <div class="flex items-center justify-end mb-4 sm:mb-6">
        <button 
          id="cartToggleTop"
          class="relative flex items-center gap-2 bg-white/[0.03] backdrop-blur-sm border border-white/[0.06] rounded-full px-4 py-2 text-sm font-medium text-white/60 hover:text-white hover:bg-white/[0.06] hover:border-white/12 transition-all duration-300 shadow-sm"
          onclick="toggleCart()"
        >
          <div class="relative">
            <i class="fas fa-shopping-bag text-base"></i>
            <span id="cartCountTop" class="absolute -top-1.5 -right-1.5 bg-cyan-400 text-black text-[10px] font-black rounded-full w-5 h-5 flex items-center justify-center shadow-md">0</span>
          </div>
          <span class="hidden sm:inline font-medium">Carrito</span>
        </button>
      </div>

      <!-- Título y branding -->
      <div class="text-center max-w-3xl mx-auto pb-2">
        <div class="inline-block relative mb-2">
          <div class="absolute -inset-6 rounded-full bg-gradient-to-r from-indigo-500/5 via-cyan-500/5 to-purple-500/5 blur-3xl"></div>
          <h1 class="relative font-display text-7xl sm:text-8xl lg:text-9xl tracking-[0.15em] text-transparent bg-clip-text bg-gradient-to-r from-cyan-200 via-indigo-200 to-purple-200 drop-shadow-2xl select-none">
            ZAZA
          </h1>
        </div>
        <p class="font-display text-lg sm:text-2xl lg:text-3xl tracking-[0.4em] sm:tracking-[0.5em] text-indigo-300/60 mb-3">SMOKE SHOP</p>
        
        <!-- Badges informativos -->
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-gray-500 font-medium">
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/[0.02] border border-white/[0.04]">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400/60"></span>
            Catálogo Premium
          </span>
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/[0.02] border border-white/[0.04]">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400/60"></span>
            Calidad Garantizada
          </span>
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/[0.02] border border-white/[0.04]">
            <i class="fab fa-whatsapp text-green-400/70 text-xs"></i>
            Pago por WhatsApp
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- BARRA DE NAVEGACIÓN STICKY - SIEMPRE VISIBLE -->
  <nav class="sticky top-0 z-40 bg-[#0A0A0F]/95 backdrop-blur-xl border-b border-white/[0.04] shadow-lg shadow-black/10" id="stickyNav">
    <div class="container mx-auto">
      <!-- Versión Desktop: Botones organizados con scroll horizontal -->
      <div class="hidden md:flex items-center gap-1.5 px-4 py-2.5 overflow-x-auto scrollbar-none">
        <a href="#top" class="nav-btn flex-shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-500 hover:text-white hover:bg-white/[0.04] transition-all duration-200">
          <i class="fas fa-home text-[10px]"></i>
          <span>Inicio</span>
        </a>
        <div class="w-px h-5 bg-white/[0.06] mx-1 flex-shrink-0"></div>
        {Object.entries(categories).map(([catName, data]) => (
          <a
            href={`#${data.slug}`}
            class={`nav-btn flex-shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-500 hover:text-white hover:bg-white/[0.04] transition-all duration-200`}
          >
            <i class={`fas ${categoryIcons[catName] || 'fa-tag'} text-[10px]`}></i>
            <span class="whitespace-nowrap">{catName.length > 20 ? catName.substring(0, 20) + '...' : catName}</span>
          </a>
        ))}
      </div>

      <!-- Versión Móvil: Menú desplegable compacto -->
      <div class="md:hidden px-3 py-2">
        <button 
          onclick="toggleMobileNav()"
          class="w-full flex items-center justify-between gap-2 bg-white/[0.03] border border-white/[0.06] rounded-xl px-4 py-2.5 text-sm font-bold text-white/80 hover:text-white hover:bg-white/[0.05] transition-all duration-200"
          id="mobileNavToggle"
        >
          <div class="flex items-center gap-2">
            <i class="fas fa-th-large text-cyan-400/60 text-xs"></i>
            <span id="mobileNavLabel">Explorar categorías</span>
          </div>
          <i class="fas fa-chevron-down text-xs text-gray-500 transition-transform duration-300" id="mobileNavChevron"></i>
        </button>
        
        <!-- Panel desplegable de categorías -->
        <div id="mobileNavPanel" class="hidden mt-2 bg-[#0A0A0F]/98 backdrop-blur-xl border border-white/[0.06] rounded-2xl overflow-hidden shadow-xl shadow-black/20 transition-all duration-300">
          <div class="p-2 space-y-1 max-h-[50vh] overflow-y-auto">
            <a href="#top" onclick="toggleMobileNav()" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all duration-200">
              <span class="w-8 h-8 rounded-lg bg-white/[0.03] flex items-center justify-center flex-shrink-0">
                <i class="fas fa-home text-xs text-gray-500"></i>
              </span>
              <span>Inicio</span>
            </a>
            {Object.entries(categories).map(([catName, data]) => (
              <a
                href={`#${data.slug}`}
                onclick="toggleMobileNav()"
                class={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all duration-200`}
              >
                <span class={`w-8 h-8 rounded-lg bg-${categoryAccentColors[catName] || 'gray'}-500/10 flex items-center justify-center flex-shrink-0`}>
                  <i class={`fas ${categoryIcons[catName] || 'fa-tag'} text-xs text-${categoryAccentColors[catName] || 'gray'}-400/70`}></i>
                </span>
                <span class="whitespace-nowrap">{catName}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Indicador de progreso sutil -->
    <div class="h-[1px] bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent"></div>
  </nav>

  <!-- CATÁLOGO PRINCIPAL -->
  <main class="container mx-auto px-4 pb-32 md:pb-40 mt-6 md:mt-8 max-w-7xl">
    {Object.entries(categories).map(([catName, data]) => (
      <section id={data.slug} class="mb-14 md:mb-16 scroll-mt-28">
        <!-- Encabezado de sección -->
        <div class="flex items-center gap-3 mb-4 md:mb-6">
          <div class={`flex-shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-xl bg-${categoryAccentColors[catName] || 'gray'}-500/10 border border-${categoryAccentColors[catName] || 'gray'}-500/20 flex items-center justify-center`}>
            <i class={`fas ${categoryIcons[catName] || 'fa-tag'} text-${categoryAccentColors[catName] || 'gray'}-300 text-sm md:text-base`}></i>
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="font-display text-xl md:text-2xl lg:text-3xl tracking-wider text-white truncate">
              {catName.toUpperCase()}
            </h2>
            <p class="text-gray-600 text-xs font-medium mt-0.5">{data.products.length} productos</p>
          </div>
        </div>

        <!-- Grid de productos -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4 lg:gap-5">
          {data.products.map((product) => (
            <div 
              class="product-card group relative bg-[#0f0f17] backdrop-blur-sm border border-white/[0.06] rounded-2xl p-3 md:p-4 flex flex-col h-full transition-all duration-300 ease-out cursor-pointer hover:bg-[#12121a] hover:border-white/[0.12] hover:shadow-lg hover:shadow-black/20"
              data-id={product.id}
            >
              {/* Imagen del producto */}
              <div class="relative mb-3 rounded-xl bg-gradient-to-b from-white/[0.02] to-transparent p-3 aspect-square flex items-center justify-center overflow-hidden">
                <img
                  src={`${base}${product.customIcon.replace(/^\//, '')}`}
                  alt={product.name}
                  class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <span style="display:none;" class="text-5xl absolute inset-0 flex items-center justify-center opacity-40">{product.emoji}</span>
                
                {product.badge && (
                  <span class={`absolute top-2 right-2 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-lg bg-${categoryAccentColors[catName] || 'gray'}-500/15 border border-${categoryAccentColors[catName] || 'gray'}-500/20 text-${categoryAccentColors[catName] || 'gray'}-300/80`}>
                    {product.badge}
                  </span>
                )}
              </div>
              
              {/* Información */}
              <div class="flex-1 flex flex-col">
                <h3 class="font-semibold text-sm text-gray-200 leading-snug mb-1 line-clamp-2 group-hover:text-white transition-colors duration-300">
                  {product.name}
                </h3>
                
                <p class="text-gray-500 text-xs leading-relaxed mb-2 line-clamp-2 flex-1">
                  {product.desc}
                </p>
                
                {/* Promo */}
                {product.promo && (
                  <div class="mb-2 px-2.5 py-1.5 rounded-lg bg-cyan-400/[0.04] border border-cyan-400/10 text-cyan-300/80 text-xs font-bold">
                    {!product.promo.includes('×') && !product.promo.includes('|') && (
                      <span class="text-gray-500 font-medium mr-1">Unitario:</span>
                    )}
                    {product.promo}
                  </div>
                )}

                {/* Opciones bulk */}
                {product.bulkOptions && (
                  <div class="grid grid-cols-4 gap-1 mb-2">
                    {product.bulkOptions.map(opt => (
                      <button 
                        class="bulk-btn text-[10px] font-bold bg-white/[0.03] hover:bg-white/[0.08] text-gray-400 hover:text-white py-1.5 px-1 rounded-lg transition-all duration-200 active:scale-95"
                        onclick={`selectBulkQty(${product.id}, ${opt.qty})`}
                        data-qty={opt.qty}
                      >
                        {opt.label}
                      </button>
                    ))}
                  </div>
                )}
                
                {/* Precio */}
                <div class="text-lg md:text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-amber-500 mb-3 tabular-nums">
                  ${product.price.toLocaleString('es-CO')}
                </div>

                <!-- Acciones -->
                <div class="mt-auto space-y-2">
                  <div class="flex items-center justify-center gap-1 bg-black/30 rounded-full p-0.5 border border-white/[0.05]">
                    <button 
                      class="w-8 h-8 rounded-full bg-transparent hover:bg-white/[0.06] text-gray-400 hover:text-white text-sm font-medium flex items-center justify-center transition-all duration-200"
                      onclick={`changeQty(event, ${product.id}, -1)`}
                    >−</button>
                    <input 
                      type="number" 
                      id={`qty-${product.id}`}
                      value="1" 
                      min="1" 
                      max="99"
                      readonly
                      class="w-10 text-center bg-transparent border-none text-white text-sm font-bold outline-none tabular-nums"
                    />
                    <button 
                      class="w-8 h-8 rounded-full bg-transparent hover:bg-white/[0.06] text-gray-400 hover:text-white text-sm font-medium flex items-center justify-center transition-all duration-200"
                      onclick={`changeQty(event, ${product.id}, 1)`}
                    >+</button>
                  </div>
                  
                  <button 
                    class="w-full bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white text-xs font-bold py-3 rounded-xl flex items-center justify-center gap-1.5 transition-all duration-200 active:scale-[0.98] shadow-lg shadow-indigo-900/10 hover:shadow-indigo-900/20 min-h-[44px]"
                    onclick={`addToCart(${product.id})`}
                  >
                    <i class="fas fa-plus text-[10px]"></i>
                    <span>Añadir</span>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>

  <!-- BOTÓN CARRITO FLOTANTE -->
  <div id="cartFloat" class="fixed bottom-6 right-4 md:right-6 z-30">
    <button
      id="cartFloatBtn"
      onclick="toggleCart()"
      class="flex items-center gap-3 bg-[#0f0f17]/95 backdrop-blur-xl border border-white/[0.08] hover:border-cyan-500/20 rounded-2xl px-4 py-3 shadow-xl shadow-black/20 hover:shadow-cyan-900/5 transition-all duration-300 active:scale-95 group"
    >
      <div class="relative">
        <i class="fas fa-shopping-bag text-white/80 text-lg group-hover:text-cyan-300 transition-colors duration-300"></i>
        <span id="cartBadge" class="absolute -top-2 -right-2 bg-cyan-400 text-black text-[10px] font-black rounded-full w-5 h-5 flex items-center justify-center shadow-md">0</span>
      </div>
      <div class="text-left hidden sm:block">
        <p class="text-white/70 font-semibold text-xs leading-none group-hover:text-white transition-colors duration-300">Carrito</p>
        <p id="cartTotal" class="text-cyan-300/80 text-xs font-bold leading-none mt-1 tabular-nums group-hover:text-cyan-300 transition-colors duration-300">$0</p>
      </div>
      <i class="fas fa-chevron-up text-gray-600 group-hover:text-white text-xs transition-all duration-300 hidden sm:block" id="cartChevron"></i>
    </button>
  </div>

  <!-- PANEL CARRITO -->
  <div id="cartPanel" class="fixed inset-x-0 bottom-0 z-50 transform translate-y-full transition-transform duration-400 ease-out">
    <div class="bg-[#0A0A0F]/98 backdrop-blur-2xl border-t border-white/[0.06] rounded-t-3xl shadow-2xl max-h-[85vh] flex flex-col mx-auto max-w-2xl">
      <div class="flex justify-center pt-3 pb-1">
        <div class="w-12 h-1 rounded-full bg-white/[0.08]"></div>
      </div>
      
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/[0.04]">
        <h3 class="font-display text-xl md:text-2xl tracking-wider text-white/90">MI PEDIDO</h3>
        <button onclick="toggleCart()" class="text-gray-600 hover:text-white transition-colors p-2 rounded-full hover:bg-white/[0.04]">
          <i class="fas fa-times text-lg"></i>
        </button>
      </div>

      <div id="cartItems" class="flex-1 overflow-y-auto px-4 py-4 space-y-2">
        <div id="cartEmpty" class="text-center py-16">
          <div class="text-5xl mb-3 opacity-40">🛒</div>
          <p class="text-gray-500 font-semibold">Tu carrito está vacío</p>
          <p class="text-gray-600 text-xs mt-1">Agrega productos para comenzar</p>
        </div>
      </div>

      <div class="px-4 py-5 border-t border-white/[0.04] bg-black/20">
        <div class="flex justify-between items-center mb-4">
          <span class="text-gray-500 font-medium text-sm">Total a pagar:</span>
          <span id="cartTotalDisplay" class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-amber-500 tabular-nums">$0</span>
        </div>
        <div class="flex gap-2.5">
          <button
            onclick="clearCart()"
            class="flex-1 border border-white/[0.06] hover:border-red-500/30 hover:text-red-400 text-gray-600 py-3 rounded-xl font-bold text-xs transition-all duration-200 flex items-center justify-center gap-1.5 group"
          >
            <i class="fas fa-trash-alt text-[10px] group-hover:text-red-400 transition-colors duration-200"></i>
            <span>Limpiar</span>
          </button>
          <button
            id="whatsappBtn"
            onclick="checkoutWhatsApp()"
            class="flex-[2] bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 shadow-lg shadow-green-900/10 hover:shadow-green-900/20 transition-all duration-200 active:scale-[0.98] min-h-[44px]"
          >
            <i class="fab fa-whatsapp text-base"></i>
            <span>Pedir por WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Overlay -->
  <div id="cartOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden" onclick="toggleCart()"></div>
</Layout>

<style is:global>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

  html {
    scroll-behavior: smooth;
    background-color: #0A0A0F;
  }

  body {
    background-color: #0A0A0F;
  }

  .scroll-mt-28 { scroll-margin-top: 7rem; }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #cartPanel {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  #cartPanel.open { 
    transform: translateY(0); 
  }

  .cart-item-enter {
    animation: cartItemSlide 0.25s ease-out;
  }

  @keyframes cartItemSlide {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cart-bounce {
    animation: cartBounce 0.3s ease-out;
  }

  @keyframes cartBounce {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .qty-btn:active {
    transform: scale(0.9);
  }

  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }

  /* Estilo para botones de navegación activos */
  .nav-btn.active {
    color: white;
    background: rgba(255, 255, 255, 0.05);
  }

  /* Animación del panel móvil */
  #mobileNavChevron.rotate {
    transform: rotate(180deg);
  }

  /* Animación de entrada del panel móvil */
  #mobileNavPanel {
    animation: slideDown 0.2s ease-out;
  }

  @keyframes slideDown {
    from { 
      opacity: 0; 
      transform: translateY(-8px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }
</style>

<script define:vars={{ productsData: products, BASE_URL: import.meta.env.BASE_URL }}>
  let cart = [];
  let cartOpen = false;
  let mobileNavOpen = false;
  const WA_NUMBER = "573177325057";

  // Calcular total
  window.calculateTotal = function(product, quantity, isBox = false) {
    if (isBox && product.boxOption) {
      return product.boxOption.price * quantity;
    }
    const rule = [...product.pricingRules]
      .sort((a, b) => b.minQty - a.minQty)
      .find(r => quantity >= r.minQty);
    return Math.round(quantity * (rule ? rule.pricePerUnit : product.price));
  };

  // Cambiar cantidad
  window.changeQty = function(event, productId, delta) {
    event.stopPropagation();
    const input = document.getElementById(`qty-${productId}`);
    if (!input) return;
    let current = parseInt(input.value) || 1;
    current = Math.max(1, Math.min(99, current + delta));
    input.value = current;
  };

  // Seleccionar cantidad bulk
  window.selectBulkQty = function(productId, qty) {
    const input = document.getElementById(`qty-${productId}`);
    if (input) {
      input.value = qty;
      const card = document.querySelector(`[data-id="${productId}"]`);
      const buttons = card?.querySelectorAll('.bulk-btn');
      buttons?.forEach(btn => {
        if (parseInt(btn.dataset.qty) === qty) {
          btn.classList.add('bg-white/[0.08]', 'text-white');
          btn.classList.remove('bg-white/[0.03]', 'text-gray-400');
        } else {
          btn.classList.remove('bg-white/[0.08]', 'text-white');
          btn.classList.add('bg-white/[0.03]', 'text-gray-400');
        }
      });
    }
  };

  // Añadir al carrito
  window.addToCart = function(productId) {
    const product = productsData.find(p => p.id === productId);
    if (!product) return;
    const qtyInput = document.getElementById(`qty-${productId}`);
    const quantity = parseInt(qtyInput?.value) || 1;
    const existing = cart.find(item => item.id === productId);

    if (existing) {
      existing.quantity = Math.min(99, existing.quantity + quantity);
    } else {
      cart.push({ ...product, quantity, isBox: false });
    }

    if (qtyInput) qtyInput.value = 1;
    
    const card = document.querySelector(`[data-id="${productId}"]`);
    card?.querySelectorAll('.bulk-btn').forEach(btn => {
      btn.classList.remove('bg-white/[0.08]', 'text-white');
      btn.classList.add('bg-white/[0.03]', 'text-gray-400');
    });

    updateCartUI();
    showAddedFeedback(productId);
  };

  function showAddedFeedback(productId) {
    const card = document.querySelector(`[data-id="${productId}"]`);
    if (!card) return;
    card.style.borderColor = 'rgba(6, 182, 212, 0.3)';
    card.style.boxShadow = '0 0 20px rgba(6, 182, 212, 0.06)';
    
    setTimeout(() => {
      card.style.borderColor = '';
      card.style.boxShadow = '';
    }, 600);

    const badge = document.getElementById('cartBadge');
    if (badge) {
      badge.classList.add('cart-bounce');
      setTimeout(() => badge.classList.remove('cart-bounce'), 300);
    }
  }

  function updateCartUI() {
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const totalPrice = Math.round(cart.reduce((sum, item) => sum + window.calculateTotal(item, item.quantity, item.isBox), 0));
    const formatted = '$' + totalPrice.toLocaleString('es-CO');
    
    ['cartCountTop', 'cartBadge'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = totalItems;
    });
    
    ['cartTotal', 'cartTotalDisplay'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = formatted;
    });

    renderCartItems();
  }

  function renderCartItems() {
    const container = document.getElementById('cartItems');
    const empty = document.getElementById('cartEmpty');
    if (!container) return;

    if (cart.length === 0) {
      if (empty) empty.style.display = 'block';
      container.querySelectorAll('.cart-item').forEach(el => el.remove());
      return;
    }

    if (empty) empty.style.display = 'none';
    container.querySelectorAll('.cart-item').forEach(el => el.remove());

    cart.forEach(item => {
      const rule = [...item.pricingRules]
        .sort((a, b) => b.minQty - a.minQty)
        .find(r => item.quantity >= r.minQty);
      const effectiveUnitPrice = Math.round(rule ? rule.pricePerUnit : item.price);
      const subtotal = Math.round(window.calculateTotal(item, item.quantity, item.isBox));
      
      const div = document.createElement('div');
      div.className = 'cart-item cart-item-enter flex items-center gap-3 bg-white/[0.02] rounded-2xl p-3 border border-white/[0.04]';
      
      const imgSrc = item.customIcon ? `${BASE_URL}${item.customIcon.replace(/^\//, '')}` : '';
      const imageContent = imgSrc
        ? `<img src="${imgSrc}" alt="${item.name}" class="w-12 h-12 object-contain rounded-xl bg-white/[0.02] flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">`
        : '';
      const emojiContent = `<span class="text-2xl flex-shrink-0 w-12 h-12 flex items-center justify-center bg-white/[0.02] rounded-xl ${item.customIcon ? 'hidden' : ''}">${item.emoji || '📦'}</span>`;

      div.innerHTML = `
        ${imageContent}
        ${emojiContent}
        <div class="flex-1 min-w-0">
          <p class="text-white text-sm font-semibold truncate">${item.name}</p>
          <div class="flex items-center gap-2 mt-1.5">
            <button onclick="updateCartItemQty(${item.id}, -1)" class="w-5 h-5 rounded-full bg-white/[0.04] hover:bg-white/[0.08] flex items-center justify-center text-xs text-white/70 transition-colors">−</button>
            <span class="text-xs font-bold text-white w-6 text-center tabular-nums">${item.quantity}</span>
            <button onclick="updateCartItemQty(${item.id}, 1)" class="w-5 h-5 rounded-full bg-white/[0.04] hover:bg-white/[0.08] flex items-center justify-center text-xs text-white/70 transition-colors">+</button>
            <span class="text-gray-600 text-xs ml-1">× $${effectiveUnitPrice.toLocaleString('es-CO')}</span>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="text-amber-400 font-black text-sm tabular-nums">$${subtotal.toLocaleString('es-CO')}</span>
          <button onclick="removeFromCart(${item.id})" class="w-7 h-7 rounded-full bg-transparent hover:bg-red-500/10 text-gray-600 hover:text-red-400 flex items-center justify-center text-xs transition-all duration-200">
            <i class="fas fa-times"></i>
          </button>
        </div>
      `;
      container.appendChild(div);
    });
  }

  window.removeFromCart = function(productId) {
    cart = cart.filter(item => item.id !== productId);
    updateCartUI();
  };

  window.updateCartItemQty = function(productId, delta) {
    const item = cart.find(i => i.id === productId);
    if (!item) return;
    item.quantity += delta;
    if (item.quantity <= 0) {
      window.removeFromCart(productId);
    } else {
      item.quantity = Math.min(99, item.quantity);
      updateCartUI();
    }
  };

  window.clearCart = function() {
    cart = [];
    updateCartUI();
  };

  window.toggleCart = function() {
    cartOpen = !cartOpen;
    const panel = document.getElementById('cartPanel');
    const overlay = document.getElementById('cartOverlay');
    const chevron = document.getElementById('cartChevron');
    
    if (cartOpen) {
      panel?.classList.add('open');
      overlay?.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      document.body.style.overflow = 'hidden';
    } else {
      panel?.classList.remove('open');
      overlay?.classList.add('hidden');
      if (chevron) chevron.style.transform = '';
      document.body.style.overflow = '';
    }
  };

  // Toggle del menú de navegación móvil
  window.toggleMobileNav = function() {
    mobileNavOpen = !mobileNavOpen;
    const panel = document.getElementById('mobileNavPanel');
    const chevron = document.getElementById('mobileNavChevron');
    const label = document.getElementById('mobileNavLabel');
    
    if (mobileNavOpen) {
      panel?.classList.remove('hidden');
      chevron?.classList.add('rotate');
      if (label) label.textContent = 'Ocultar categorías';
    } else {
      panel?.classList.add('hidden');
      chevron?.classList.remove('rotate');
      if (label) label.textContent = 'Explorar categorías';
    }
  };

  // Resaltar categoría activa al hacer scroll
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('stickyNav');
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-btn');
    
    let current = '';
    sections.forEach(section => {
      const sectionTop = section.offsetTop - 150;
      if (window.scrollY >= sectionTop) {
        current = section.getAttribute('id');
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.add('active');
      }
    });
  });

window.checkoutWhatsApp = function() {
    if (cart.length === 0) {
      alert('Tu carrito está vacío. Agrega productos antes de pedir.');
      return;
    }
    
    const SHIPPING_COST = 18000;
    
    let message = 'ZAZA SMOKE SHOP - Pedido\n\n';
    
    message += 'PRODUCTOS:\n';
    let subtotal = 0;
    cart.forEach(item => {
      const itemSubtotal = window.calculateTotal(item, item.quantity, item.isBox);
      const unitPrice = Math.round(window.calculateTotal(item, 1, item.isBox));
      message += `• ${item.name}\n`;
      message += `  Cantidad: ${item.quantity} × $${unitPrice.toLocaleString('es-CO')} = $${Math.round(itemSubtotal).toLocaleString('es-CO')}\n`;
      subtotal += itemSubtotal;
    });
    
    const total = Math.round(subtotal) + SHIPPING_COST;
    
    message += `\nSubtotal: $${Math.round(subtotal).toLocaleString('es-CO')}\n`;
    message += `Envío a todo Colombia: $${SHIPPING_COST.toLocaleString('es-CO')}\n`;
    message += `TOTAL A PAGAR: $${total.toLocaleString('es-CO')}\n`;
    
    message += '\nEl envío incluye seguimiento y entrega puerta a puerta.';
    message += '\n\nPor favor indícanos tu dirección de entrega:\n';
    message += 'Departamento: \n';
    message += 'Ciudad: \n';
    message += 'Dirección (calle, número, apto): \n';
    
    message += '\nGracias, confirmaremos tu pedido en breve.';
    
    const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');
  };
 
  updateCartUI();
</script>